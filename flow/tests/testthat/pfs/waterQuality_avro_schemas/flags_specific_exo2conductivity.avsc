    {
      "name": "specificConductanceNullQF",
      "type": [
        "null",
        "int"
        ],
      "default": null,
      "doc": "Specific conductance quality flag for the null test detailed in NEON.DOC.011081 (1=fail, 0=pass, -1=NA (i.e., could not be run))",
      "__neon_units": "NA"
    },
    {
